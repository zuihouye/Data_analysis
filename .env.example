DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taobao_user
# Flask session 签名密钥。生成方式：
#   python -c "import secrets; print(secrets.token_hex(32))"
# 不设置也能跑（会临时随机生成），但每次重启所有登录都会失效。
SECRET_KEY=

# Redis：只给支付锁和幂等用。刻意用独立的 db（1），跟业务缓存分开。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# 锁参数（一般不用改）
# PAY_LOCK_TTL_MS=10000      # 锁最长持有 10 秒，超了自动释放
# PAY_LOCK_WAIT_MS=3000      # 抢不到时最多等 3 秒，等不到回 409
# PAY_IDEMPOTENT_TTL=86400   # 幂等结果保留 24 小时