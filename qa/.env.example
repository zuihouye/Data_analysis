# ===== qa/.env —— 复制这个文件为 qa/.env，然后按你自己的环境改值 =====
# 注意：这个文件只放“账号+地址”，不要把真实密码提交到 git（qa/.env 要加进 .gitignore）。

# 被测服务地址（本地默认；换端口就改这里）
BASE_URL=http://127.0.0.1:5000

# 员工/管理员账号（role=1 或 2，能进客户管理、商品管理、订单管理）
# 没有账号？在 E:\Flask_app 目录执行（命令名是 create_admin，别写错）：
#   python -m flask --app app create_admin --phone 13900000000 --username 测试员工 --password 你的密码 --role 1
STAFF_PHONE=
STAFF_PASSWORD=

# 客户账号（role=0，可不填；不填时越权类用例会自动 skip）
CUSTOMER_PHONE=
CUSTOMER_PASSWORD=

# Selenium 是否无头运行：1=不弹浏览器（推荐），0=弹出浏览器方便看过程
HEADLESS=1
